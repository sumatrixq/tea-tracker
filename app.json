{
  "expo": {
    "name": "Чайный путь",
    "slug": "chai-puti",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "newArchEnabled": false,
    "splash": { "image": "./assets/icon.png", "resizeMode": "contain", "backgroundColor": "#6E0E0E" },
    "android": {
      "package": "ru.chayputi.app",
      "versionCode": 2,
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#8E1616" },
      "permissions": ["VIBRATE", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/bell.wav",
            "./assets/sounds/gong.wav",
            "./assets/sounds/chime.wav",
            "./assets/sounds/bowl.wav",
            "./assets/sounds/beep.wav"
          ]
        }
      ]
    ]
  }
}
